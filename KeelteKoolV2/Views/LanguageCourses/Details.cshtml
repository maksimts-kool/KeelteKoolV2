@model KeelteKoolV2.Models.LanguageCourses.LanguageCourseViewModel
<h1>Andmed</h1>

<div>
    <h4>Keelekursus</h4>
    <hr/>
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Id" class="col-sm-2 col-form-label"></label>
            <span>@Html.DisplayFor(model => model.Id)</span>
        </div>
    </dl>
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Nimetus" class="col-sm-2 col-form-label"></label>
            <span>@Html.DisplayFor(model => model.Nimetus)</span>
        </div>
    </dl>
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Keel" class="col-sm-2 col-form-label"></label>
            <span>@Html.DisplayFor(model => model.Keel)</span>
        </div>
    </dl>
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Kirjeldus" class="col-sm-2 col-form-label"></label>
            <span>@Html.DisplayFor(model => model.Kirjeldus)</span>
        </div>
    </dl>
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Tase" class="col-sm-2 col-form-label"></label>
            <span>@Html.DisplayFor(model => model.Tase)</span>
        </div>
    </dl>
    <a asp-action="Update" asp-controller="LanguageCourses" asp-route-id="@Model.Id" class="btn btn-warning">Muuda</a>
    <a asp-action="Index" asp-controller="LanguageCourses" class="btn btn-primary">Tagasi</a>

</div>