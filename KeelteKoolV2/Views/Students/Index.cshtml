@model IEnumerable<KeelteKoolV2.Models.Students.StudentViewModel>
@{
    int rownumber = 1;
    ViewBag.Title = "Õpilased";
}
<div>
    <a asp-action="Create" asp-controller="Students" class="btn btn-dark">Lisa uus õpilane</a>
</div>

<div class="h1">
    Õpilased
</div>
<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">Nr</th>
            <th scope="col">Eesnimi</th>
            <th scope="col">Perekonnanimi</th>
            <th scope="col">E-post</th>
            <th scope="col">Tegevused</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@rownumber</td>
                <td>@student.FirstName</td>
                <td>@student.LastName</td>
                <td>@student.Email</td>
                <td>
                    <a asp-action="Details" asp-controller="Students" asp-route-id="@student.Id" class="btn btn-secondary">Andmed</a>
                    <a asp-action="Update" asp-controller="Students" asp-route-id="@student.Id" class="btn btn-warning">Uuenda</a>
                    <a asp-action="Delete" asp-controller="Students" asp-route-id="@student.Id" class="btn btn-danger">Kustuta</a>
                </td>
            </tr>
            rownumber++;
        }
    </tbody>
</table>
