@model KeelteKoolV2.Models.Lecturers.LecturerViewModel

@* sama vorm on nii loomiseks kui uuendamiseks, Id olemasolu järgi valitakse tegevus *@
@{
    bool isUpdate = Model.Id != null;
}

<h1>@(isUpdate ? "Uuenda õppejõudu" : "Loo õppejõud")</h1>

<div>
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input asp-for="Id" type="hidden"/>
        <input asp-for="CreatedAt" type="hidden"/>
        <input asp-for="UserID" type="hidden"/>

        <div class="form-group">
            <label asp-for="FirstName" class="control-label"></label>
            <input asp-for="FirstName" class="form-control"/>
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LastName" class="control-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Qualifications" class="control-label"></label>
            <input asp-for="Qualifications" class="form-control" />
            <span asp-validation-for="Qualifications" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Files" class="control-label"></label>
            <input asp-for="Files" type="file" multiple accept="image/*" class="form-control" />
        </div>

        @foreach (var image in Model.Image)
        {
            <div class="mt-2">
                <img src="@image.Image" alt="@image.ImageTitle" style="max-height:120px" />
                <button type="submit" asp-action="RemoveImage" asp-controller="Lecturers" asp-route-ImageID="@image.ImageID" formnovalidate class="btn btn-sm btn-danger">Eemalda pilt</button>
            </div>
        }

        @if (isUpdate)
        {
            <input asp-action="Update" asp-controller="Lecturers" type="submit" value="Salvesta" class="btn btn-success"/>
            <a asp-action="Index" asp-controller="Lecturers" class="btn btn-secondary">Tühista</a>
        }
        else
        {
            <input asp-action="Create" asp-controller="Lecturers" type="submit" value="Loo õppejõud" class="btn btn-success"/>
        }

    </form>
</div>
