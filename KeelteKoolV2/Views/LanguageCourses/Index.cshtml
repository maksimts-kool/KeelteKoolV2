@model IEnumerable<KeelteKoolV2.Models.LanguageCourses.LanguageCourseViewModel>
@{
    int rownumber = 1;
    ViewBag.Title = "Keelekursused";
}
@* Later check for role of the user, hide this button if not admin or teacher \/ *@
<div>
    <a id="IndexCreateNewLanguageCourse_BTN" asp-action="create" asp-controller="LanguageCourses" type="submit" class="btn btn-dark">Lisa uus keelekursus</a>
</div>

<div class="h1">
    Keelekursused
</div>
<form method="get">
    <table id="IndexTable" class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Nimetus</th>
                <th scope="col">Õpetatav keel</th>
                <th scope="col">Tegevused</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
                {
                    <tr>
                        <td>@rownumber</td>
                        <td id="IndexTableCourseNimetus">@course.Nimetus</td>
                        <td id="IndexTableCourseKeel">@course.Keel</td>
                        <td id="IndexTableCourseActions">
                            <!-- TODO: add details, update and delete functionality from controller -->
                            <a id="IndexTableCourseDetails_BTN" asp-action="Details" asp-controller="LanguageCourses" asp-route-id="@course.Id" class="btn btn-secondary">Andmed</a>
                            <a id="IndexTableCourseUpdate_BTN" asp-action="Update" asp-controller="LanguageCourses" asp-route-id="@course.Id" class="btn btn-warning">Uuenda</a>
                            <a id="IndexTableCourseDelete_BTN" asp-action="Delete" asp-controller="LanguageCourses" asp-route-id="@course.Id" class="btn btn-danger">Kustuta</a>
                        </td>
                    </tr>
                    rownumber++;
                }
        </tbody>
    </table>
</form>
