@model KeelteKoolV2.Models.LanguageCourses.LanguageCourseViewModel

@* sama vorm on nii loomiseks kui uuendamiseks, Id olemasolu järgi valitakse tegevus *@
@{
    bool isUpdate = Model.Id != null;
}

<h1>@(isUpdate ? "Uuenda keelekursust" : "Loo keelekursus")</h1>

<div>
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input asp-for="Id" type="hidden"/>
        <input asp-for="CreatedAt" type="hidden"/>

        <div class="form-group">
            <label asp-for="Nimetus" class="control-label"></label>
            <input asp-for="Nimetus" class="form-control"/>
            <span asp-validation-for="Nimetus" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Keel" class="control-label"></label>
            <input asp-for="Keel" class="form-control" />
            <span asp-validation-for="Keel" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Tase" class="control-label"></label>
            <input asp-for="Tase" class="form-control" />
            <span asp-validation-for="Tase" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Kirjeldus" class="control-label"></label>
            <input asp-for="Kirjeldus" class="form-control" />
            <span asp-validation-for="Kirjeldus" class="text-danger"></span>
        </div>

        @if (isUpdate)
        {
            <input asp-action="Update" asp-controller="LanguageCourses" type="submit" value="Salvesta" class="btn btn-success"/>
            <a asp-action="Index" asp-controller="LanguageCourses" class="btn btn-secondary">Tühista</a>
        }
        else
        {
            <input asp-action="Create" asp-controller="LanguageCourses" type="submit" value="Loo Keelekursus" class="btn btn-success"/>
        }

    </form>
</div>