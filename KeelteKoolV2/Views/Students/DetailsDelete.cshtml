@model KeelteKoolV2.Models.Students.StudentViewModel
@{
    bool isDelete = (ViewData["ViewType"] as string) == "delete";
}
<h1>@(isDelete ? "Kustuta õpilane" : "Andmed")</h1>

<div>
    <h4>@(isDelete ? "Kas oled kindel, et soovid selle õpilase kustutada?" : "Õpilane")</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Id)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.Id)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.FirstName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.FirstName)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.LastName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.LastName)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Email)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.Email)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.DateOfBirth)</dt>
        <dd class="col-sm-10">@Model.DateOfBirth?.ToString("dd.MM.yyyy")</dd>
    </dl>

    @if (isDelete)
    {
        <form asp-action="Delete" asp-controller="Students" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="submit" value="Kustuta" class="btn btn-danger" />
            <a asp-action="Index" asp-controller="Students" class="btn btn-secondary">Tühista</a>
        </form>
    }
    else
    {
        <a asp-action="Update" asp-controller="Students" asp-route-id="@Model.Id" class="btn btn-warning">Muuda</a>
        <a asp-action="Index" asp-controller="Students" class="btn btn-primary">Tagasi</a>
    }
</div>
