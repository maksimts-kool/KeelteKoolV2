@model IEnumerable<KeelteKoolV2.Models.Lecturers.LecturerViewModel>
@{
    int rownumber = 1;
    ViewBag.Title = "Õppejõud";
}
<div>
    <a asp-action="Create" asp-controller="Lecturers" class="btn btn-dark">Lisa uus õppejõud</a>
</div>

<div class="h1">
    Õppejõud
</div>
<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">Nr</th>
            <th scope="col">Eesnimi</th>
            <th scope="col">Perekonnanimi</th>
            <th scope="col">Tegevused</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lecturer in Model)
        {
            <tr>
                <td>@rownumber</td>
                <td>@lecturer.FirstName</td>
                <td>@lecturer.LastName</td>
                <td>
                    <a asp-action="Details" asp-controller="Lecturers" asp-route-id="@lecturer.Id" class="btn btn-secondary">Andmed</a>
                    <a asp-action="Update" asp-controller="Lecturers" asp-route-id="@lecturer.Id" class="btn btn-warning">Uuenda</a>
                    <a asp-action="Delete" asp-controller="Lecturers" asp-route-id="@lecturer.Id" class="btn btn-danger">Kustuta</a>
                </td>
            </tr>
            rownumber++;
        }
    </tbody>
</table>
